# Copy to .env and fill in. Never commit .env.

ENVIRONMENT=development          # development | test | production
LOG_LEVEL=INFO
APP_BASE_URL=                    # public https URL in production (used for webhooks)

DATABASE_URL=postgresql+asyncpg://swordbot:swordbot@localhost:5432/swordbot
# Without Docker: DATABASE_URL=sqlite+aiosqlite:///./swordbot.db
# Tests only (wiped by the test suite): TEST_DATABASE_URL=postgresql+asyncpg://swordbot:swordbot@localhost:5432/swordbot_test

# Event worker (defaults shown; retries give up after ~30 minutes)
WORKER_ENABLED=true
WORKER_CONCURRENCY=4
WORKER_POLL_INTERVAL_SECONDS=1.0
EVENT_MAX_ATTEMPTS=8
EVENT_RETRY_BASE_SECONDS=15
EVENT_RETRY_MAX_SECONDS=1800
EVENT_LEASE_SECONDS=300

OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-5

TELEGRAM_BOT_TOKEN=123456:your-bot-token
TELEGRAM_WEBHOOK_SECRET=random-long-string
TELEGRAM_ALLOWED_USER_ID=000000000

GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8080/
GMAIL_REFRESH_TOKEN=
