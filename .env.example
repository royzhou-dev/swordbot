# Copy to .env and fill in. Never commit .env.

ENVIRONMENT=development          # development | test | production
LOG_LEVEL=INFO
APP_BASE_URL=                    # public https URL in production (used for webhooks)
USER_TIMEZONE=UTC                # your IANA timezone, e.g. America/Los_Angeles (resolves "tonight")

DATABASE_URL=postgresql+asyncpg://swordbot:swordbot@localhost:5432/swordbot
# Without Docker: DATABASE_URL=sqlite+aiosqlite:///./swordbot.db
# Tests only (wiped by the test suite): TEST_DATABASE_URL=postgresql+asyncpg://swordbot:swordbot@localhost:5432/swordbot_test

# Event worker (defaults shown; retries give up after ~30 minutes)
WORKER_ENABLED=true
WORKER_CONCURRENCY=4
WORKER_POLL_INTERVAL_SECONDS=1.0
EVENT_MAX_ATTEMPTS=8
EVENT_RETRY_BASE_SECONDS=15
EVENT_RETRY_MAX_SECONDS=1800
EVENT_LEASE_SECONDS=300

OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-5
OPENAI_TIMEOUT_SECONDS=45                # per request
OPENAI_MAX_RETRIES=1                     # SDK's quick retries; the worker retries longer outages

TELEGRAM_BOT_TOKEN=123456:your-bot-token
TELEGRAM_WEBHOOK_SECRET=random-long-string     # A-Z a-z 0-9 _ - only (Telegram's rule)
TELEGRAM_ALLOWED_USER_ID=000000000             # your numeric id; see README "Telegram bot setup"
# TELEGRAM_API_BASE_URL=https://api.telegram.org

# Gmail (README "Gmail setup"). Without all three credentials, sends report "Gmail isn't connected".
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com   # a "Desktop app" OAuth client
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://127.0.0.1:8080/     # loopback address scripts/gmail_auth.py listens on
GMAIL_REFRESH_TOKEN=                           # printed by scripts/gmail_auth.py; keep secret
GMAIL_SENDER_ADDRESS=                          # your Gmail address, for the From header
